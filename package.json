{
  "name": "torah-ore-countdown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "build:standalone": "npm run build && node scripts/standalone.mjs",
    "test:standalone": "node scripts/test-standalone.mjs",
    "test:browser": "node scripts/browser-review.mjs",
    "build:hosted": "tsc -b && vite build --mode hosted && node scripts/offline.mjs && node scripts/standalone.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@vercel/blob": "^2.9.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.6.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^32.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
