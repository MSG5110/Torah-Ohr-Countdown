{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "buildCommand":"npm run build:hosted",
  "outputDirectory":"dist",
  "rewrites":[{"source":"/admin","destination":"/index.html"}],
  "headers":[
    {"source":"/api/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/(.*)","headers":[{"key":"Referrer-Policy","value":"same-origin"},{"key":"X-Frame-Options","value":"SAMEORIGIN"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
